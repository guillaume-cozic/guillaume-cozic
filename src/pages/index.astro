---
import Layout from '../layouts/Layout.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ZouriteAnimation from '../components/animations/ZouriteAnimation.astro';
import QaRunnerAnimation from '../components/animations/QaRunnerAnimation.astro';
import AttelyaAnimation from '../components/animations/AttelyaAnimation.astro';
import ButterflyAnimation from '../components/animations/ButterflyAnimation.astro';

const method = [
  {
    step: 'Des tests unitaires solides',
    text: "L'architecture hexagonale isole le métier : les tests unitaires couvrent chaque fonctionnalité et bloquent les régressions d'une itération à l'autre avec l'IA.",
    tools: ['Architecture hexagonale', 'Tests unitaires'],
  },
  {
    step: 'Un harnais : skills et Spec Kit',
    text: "Des skills guident l'IA vers un code hexagonal de qualité, couche par couche. Avec Spec Kit (spec-driven development), l'agent a une vision d'ensemble de ce qu'il va construire avant d'écrire une ligne.",
    tools: ['Skills Claude Code', 'Spec Kit'],
  },
  {
    step: 'Des checks déterministes',
    text: "Des règles vérifiées par des outils, pas par l'IA : PHPArkitect contrôle que les couches domaine, application et infrastructure ne sont jamais mélangées, PHPStan traque erreurs et code smells.",
    tools: ['PHPArkitect', 'PHPStan', 'dependency-cruiser'],
  },
  {
    step: 'Une QA automatisée',
    text: "Un agent joue des scénarios fonctionnels prédéfinis sur plusieurs navigateurs et remonte les incohérences, voire certaines failles de sécurité.",
    tools: ['QA Runner', 'Playwright', 'Chromium · Firefox · WebKit'],
  },
];
---

<Layout
  title="Guillaume Cozic · Product Engineer"
  description="CV interactif de Guillaume Cozic, Product Engineer : QA Runner, Attelya, le support Butterfly 360 et Zouritebnb, quatre produits conçus et livrés avec des agents IA."
>
  <div class="progress" aria-hidden="true"></div>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="#top" class="brand">G·C</a>
      <nav aria-label="Projets">
        <a href="#qa-runner" data-nav="qa-runner">QA Runner</a>
        <a href="#attelya" data-nav="attelya">Attelya</a>
        <a href="#butterfly" data-nav="butterfly">Butterfly</a>
        <a href="#zouritebnb" data-nav="zouritebnb">Zouritebnb</a>
        <a href="#methode" data-nav="methode">Méthode</a>
      </nav>
      <a class="topbar-cv" href={`${import.meta.env.BASE_URL}CV_Guillaume_Cozic_Product_Engineer.pdf`} download><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg><span>CV PDF</span></a>
    </div>
  </header>

  <main id="top">
    <section class="hero" id="intro">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container">
        <div class="hero-head">
          <div class="hero-id">
            <p class="role reveal">
              <span class="role-product">Produit</span>
              <span class="role-line" aria-hidden="true"></span>
              <span class="role-main">Product Engineer</span>
              <span class="role-line" aria-hidden="true"></span>
              <span class="role-tech">Tech</span>
            </p>
            <h1 class="reveal">Guillaume Cozic</h1>
            <p class="motto reveal">Le produit et le code, du cadrage à la mise en production.</p>
            <p class="pitch reveal">Ingénieur ISEN, plus de dix ans de back-end PHP et TypeScript en architecture hexagonale. Aujourd'hui, je conçois et livre des produits complets avec des agents IA.</p>
            <ul class="contact reveal" aria-label="Coordonnées">
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>Le Pradet (83)</li>
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>36 ans</li>
              <li><a href="tel:+33769239827"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>07 69 23 98 27</a></li>
              <li><a href="mailto:guillaume.cozic@gmail.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>guillaume.cozic@gmail.com</a></li>
              <li><a href="https://linkedin.com/in/guillaumecozic" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>linkedin.com/in/guillaumecozic</a></li>
              <li><a href="https://malt.fr/profile/guillaumecozic" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>malt.fr/profile/guillaumecozic</a></li>
              <li><a class="accent-link" href="https://www.zouritebnb.com" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" /></svg>www.zouritebnb.com</a></li>
            </ul>
            <a class="download reveal" href={`${import.meta.env.BASE_URL}CV_Guillaume_Cozic_Product_Engineer.pdf`} download><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>Télécharger mon CV <span>PDF · 364 Ko</span></a>
          </div>
          <figure class="portrait reveal">
            <span class="portrait-ring" aria-hidden="true"></span>
            <img src={`${import.meta.env.BASE_URL}guillaume-cozic.png`} width="360" height="360" alt="Portrait de Guillaume Cozic" />
          </figure>
        </div>

        <ol class="principles reveal">
          <li><span class="mono">01</span><strong>Challenger le besoin</strong><p>Questionner la valeur, découper en la plus petite unité qui valide l'hypothèse.</p></li>
          <li><span class="mono">02</span><strong>Livrer sans dette</strong><p>Architecture hexagonale + TDD, assisté par l'IA (Claude Code) : un code prêt à pivoter avec le produit.</p></li>
          <li><span class="mono">03</span><strong>Itérer</strong><p>Transformer chaque retour utilisateur en évolution, vite et en confiance.</p></li>
        </ol>

        <div class="terminal reveal" aria-label="Cycle de travail : spécifier, encadrer, déléguer, vérifier, livrer, mesurer">
          <span class="prompt">$</span>
          <span class="cmd">claude</span>
          <span class="rotator" aria-hidden="true">
            <span>« spécifie la réservation solidaire »</span>
            <span>« joue la campagne de recette »</span>
            <span>« conçois le site de Loraine »</span>
            <span>« livre la v1 en production »</span>
            <span>« mesure l'impact, puis itère »</span>
          </span>
          <span class="caret" aria-hidden="true"></span>
        </div>


        <ol class="cards reveal">
          <li style="--accent: var(--qa)">
            <a href="#qa-runner"><span class="mono">01</span><strong>QA Runner</strong><em>Recette jouée par des agents</em></a>
          </li>
          <li style="--accent: var(--at)">
            <a href="#attelya"><span class="mono">02</span><strong>Attelya</strong><em>Sites d'artistes conçus par un agent</em></a>
          </li>
          <li style="--accent: var(--bf)">
            <a href="#butterfly"><span class="mono">03</span><strong>Butterfly 360</strong><em>Tickets qualifiés et préparés par l'IA</em></a>
          </li>
          <li style="--accent: var(--zb)">
            <a href="#zouritebnb"><span class="mono">04</span><strong>Zouritebnb</strong><em>Location de vacances solidaire</em></a>
          </li>
        </ol>
      </div>
    </section>

    <ProjectSection
      id="qa-runner"
      index="01"
      kicker="Outil d'équipe"
      name="QA Runner"
      tagline="Des agents IA qui jouent vos scénarios de recette dans de vrais navigateurs, et ouvrent les tickets quand ça casse."
      period="Novembre 2026 · 5 jours"
      description="La CI de chaque projet publie ses scénarios Markdown ; l'équipe lance une campagne, suit l'agent en direct, puis consulte statuts, constats et captures. Un KO peut devenir un ticket, un tableau de bord suit la stabilité des runs."
      accent="var(--qa)"
      sceneId="scene-qarunner"
      problem="Recetter une application à la main avant chaque mise en production est long et répétitif : des scénarios finissent par être sautés, et les régressions arrivent jusqu'aux utilisateurs."
      answer="Des agents IA jouent les scénarios écrits en français, comme un testeur, sur trois navigateurs, dès que l'environnement de QA est déployé, et remontent chaque écart avec ses captures."
      ai={[
        "Un conteneur Docker par campagne : Claude Code pilote Chromium, Firefox ou WebKit via Playwright MCP.",
        "Un protocole agent ↔ API cloisonné (jetons dédiés, proxy Docker filtrant) : l'application testée n'est jamais modifiée.",
        "Un agent factice qui rejoue toute la chaîne en test, sans consommer de jetons.",
        "Huit fonctionnalités spécifiées, planifiées puis implémentées par agents avec Spec Kit.",
      ]}
      stack={['NestJS', 'Architecture hexagonale', 'PostgreSQL', 'React', 'Redux Toolkit', 'Tailwind', 'Docker', 'Playwright MCP', 'Claude Code']}
    >
      <QaRunnerAnimation />
    </ProjectSection>

    <ProjectSection
      id="attelya"
      index="02"
      kicker="SaaS pour artistes"
      name="Attelya"
      tagline="L'artiste parle de son univers, l'agent conçoit son site. En ligne en quelques minutes, pour 14 € par mois."
      period="Novembre 2026 · en cours"
      description="Une plateforme multi-clients et multi-domaines : chaque artiste conçoit un ou plusieurs sites avec un agent conversationnel, gère présentation, projets, dates et équipe dans un back-office, achète ou relie son nom de domaine, puis publie avec versions et retour arrière."
      accent="var(--at)"
      reverse
      sceneId="scene-attelya"
      problem="Un artiste de la scène a besoin d'un site pour présenter ses créations et ses dates, mais un site sur mesure coûte plusieurs milliers d'euros, puis chaque année à faire vivre, et les outils de création demandent du temps et des notions techniques."
      answer="Il décrit son univers à un assistant qui conçoit le site, puis le publie en quelques minutes : 14 € par mois, hébergement et entretien compris, sans aucune connaissance technique."
      ai={[
        "Un agent de conception intégré au produit (SDK Anthropic) : il parle d'art, jamais de technique, et l'aperçu évolue en direct.",
        "Une animation différente pour chaque type d'action de l'agent (couleurs, titres, médias), pour rendre son travail lisible.",
        "L'agent compose avec les photos et vidéos de l'artiste, depuis sa médiathèque.",
        "Un budget mensuel par artiste : l'agent se met en pause au-delà de 2 € de consommation, sans compteur anxiogène.",
      ]}
      stack={['TypeScript', 'NestJS', 'Next.js', 'React', 'Vite', 'pnpm', 'Turborepo', 'SDK Anthropic', 'Playwright']}
    >
      <AttelyaAnimation />
    </ProjectSection>

    <ProjectSection
      id="butterfly"
      index="03"
      kicker="Outil métier · support client"
      name="Butterfly 360 · Support"
      tagline="Une boîte de tickets où l'IA qualifie chaque email, l'assigne au bon agent et prépare l'action dans le LMS."
      period="Novembre 2026 · 5 jours"
      description="Le back-office de support de Butterfly Aero Training : chaque email reçu sur une boîte support d'un LMS (France, Royaume-Uni, États-Unis) devient un ticket. Les agents filtrent, assignent et répondent au client dans la même conversation, et retrouvent leur journée sur un tableau de bord."
      accent="var(--bf)"
      sceneId="scene-butterfly"
      problem="Les emails des boîtes support arrivaient en vrac et se triaient à la main. Pour chaque demande, l'agent quittait le back-office pour chercher le stagiaire dans le LMS, vérifier ses tentatives ou son attestation, puis revenait rédiger la réponse."
      answer="Un modèle qualifie chaque email (thématique, LMS, agent assigné selon les règles de l'équipe), et un assistant interroge le LMS, vérifie les règles métier, prépare l'action et la réponse. Rien n'est exécuté sans la validation de l'agent."
      ai={[
        "Qualification par LLM à l'arrivée de chaque email : thématique, LMS déduit de l'expéditeur, agent assigné selon des règles d'assignation éditables depuis l'administration.",
        "Un assistant conversationnel (NestJS, architecture hexagonale) qui interroge l'API du LMS et vérifie les règles métier avant de proposer une action : réinitialiser un test, renvoyer une attestation…",
        "L'humain garde la main : chaque action dans le LMS et chaque réponse au client attend le clic de l'agent.",
        "Un banc d'essai réservé aux administrateurs pour tester le prompt de qualification sur n'importe quel email.",
      ]}
      stack={['Symfony 8.1', 'API Platform 5', 'PHP 8.5', 'PostgreSQL', 'React 19', 'Redux Toolkit', 'NestJS 11', 'Tailwind', 'Infection', 'Stryker', 'Docker', 'Ansible']}
    >
      <ButterflyAnimation />
    </ProjectSection>

    <ProjectSection
      id="zouritebnb"
      index="04"
      kicker="Place de marché"
      name="Zouritebnb"
      tagline="La location de vacances à l'île Rodrigues où chaque séjour soutient un projet solidaire local."
      period="Mars → novembre 2026 · 8 mois"
      description="Une plateforme complète, bilingue : recherche sur carte, réservation, messagerie, avis et vérification d'identité côté voyageur ; calendrier, co-hôtes et versements côté hôte ; console d'administration des projets solidaires et blog éditorial sur l'île."
      accent="var(--zb)"
      reverse
      sceneId="scene-zouritebnb"
      problem="Quand on réserve un séjour à Rodrigues, une part de sa valeur quitte l'île."
      answer="Une plateforme dédiée à Rodrigues et éditée à Maurice : 7 % de chaque séjour sont reversés à un projet solidaire de l'île."
      ai={[
        "Des skills Claude Code par couche (architecture hexagonale, domaine, processors API, tests unitaires, d'intégration, E2E, contrats OpenAPI) : chaque agent code selon les mêmes règles.",
        "Un skill « feature-team » qui découpe une fonctionnalité verticale et lance trois agents en parallèle.",
        "Des tests de contrat OpenAPI entre l'API et le front, pour qu'un agent ne casse jamais l'autre côté.",
        "Des scénarios de recette en Markdown, rejoués par des agents sur l'environnement qa.zouritebnb.com grâce à QA Runner.",
      ]}
      stack={['Symfony', 'API Platform', 'PHP 8.5', 'React 19', 'Redux', 'TypeScript', 'Vite', 'Astro', 'MySQL', 'Docker', 'Ansible']}
    >
      <ZouriteAnimation />
    </ProjectSection>

    <section id="methode" class="method">
      <div class="container">
        <p class="eyebrow reveal">Méthode</p>
        <h2 class="reveal">Comment je garde la main sur la qualité du code produit par l'IA</h2>
        <p class="method-intro reveal">Sur tous mes projets, quatre garde-fous se complètent : l'IA va vite, ces briques garantissent qu'elle va dans la bonne direction.</p>
        <ol class="steps">
          {method.map((m, i) => (
            <li class="reveal" style={`transition-delay: ${i * 90}ms`}>
              <span class="mono">0{i + 1}</span>
              <h3>{m.step}</h3>
              <p>{m.text}</p>
              <ul class="tools">{m.tools.map((t) => <li>{t}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <p>Guillaume Cozic · Développeur full-stack</p>
      <a href="https://github.com/guillaume-cozic" rel="noopener">github.com/guillaume-cozic</a>
    </div>
  </footer>
</Layout>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--zb), var(--qa), var(--at));
    transform-origin: left;
    transform: scaleX(0);
    z-index: 30;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 16px; }
  .brand { font: 700 1.1rem var(--font-display); text-decoration: none; }
  nav { margin-left: auto; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; }
  nav a {
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--ink-3);
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
    transition: color .2s, background .2s;
  }
  nav a:hover { color: var(--ink); }
  nav a:global(.active) { color: var(--bg); background: var(--ink); }

  .hero { position: relative; padding: clamp(80px, 14vw, 160px) 0 clamp(64px, 10vw, 120px); overflow: hidden; }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    opacity: .5;
    animation: grid-drift 30s linear infinite;
  }
  @keyframes grid-drift { to { background-position: 48px 48px; } }

  .hero-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    position: relative;
  }
  .role {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    font: 600 0.8rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .role-product { color: var(--cv-orange); }
  .role-tech { color: var(--cv-blue); }
  .role-main { color: var(--ink); border-bottom: 2px dashed var(--ink-3); padding-bottom: 2px; }
  .role-line { width: 28px; height: 1.5px; background: var(--ink-3); }
  h1 {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.04em;
    margin: 14px 0 10px;
  }
  .motto {
    font: italic 400 clamp(1.25rem, 2.6vw, 1.75rem) / 1.35 'Fraunces', Georgia, serif;
    color: var(--ink);
    margin: 0 0 14px;
  }
  .pitch { color: var(--ink-2); max-width: 58ch; margin: 0 0 22px; font-size: 1.05rem; }
  .contact {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.92rem;
    color: var(--ink-2);
  }
  .contact li, .contact a { display: inline-flex; align-items: center; gap: 7px; }
  .contact a { text-decoration: none; transition: color .2s; }
  .contact a:hover { color: var(--ink); }
  .contact .accent-link { color: var(--cv-orange); }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: -8px 0 32px;
    padding: 11px 18px;
    border-radius: 12px;
    background: var(--cv-orange);
    color: #160b05;
    font-weight: 600;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
  }
  .download:hover { color: #160b05; transform: translateY(-2px); box-shadow: 0 12px 30px -12px var(--cv-orange); }
  .download:focus-visible, .topbar-cv:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .download span { font: 500 0.78rem var(--font-mono); opacity: .75; }
  .download svg, .topbar-cv svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .topbar-cv {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--cv-orange);
    color: var(--cv-orange);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  .topbar-cv:hover { background: var(--cv-orange); color: #160b05; }
  .contact svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }

  .portrait { position: relative; margin: 0; width: clamp(140px, 22vw, 240px); aspect-ratio: 1; }
  .portrait img {
    position: absolute;
    inset: 8px;
    width: calc(100% - 16px);
    height: calc(100% - 16px);
    object-fit: cover;
    border-radius: 50%;
  }
  .portrait-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--cv-orange);
    box-shadow: 0 0 60px -10px color-mix(in srgb, var(--cv-orange) 60%, transparent);
  }
  .portrait-ring::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1.5px dashed color-mix(in srgb, var(--cv-blue) 70%, transparent);
    animation: ring-spin 40s linear infinite;
  }
  @keyframes ring-spin { to { transform: rotate(360deg); } }

  .principles {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    position: relative;
  }
  .principles li { border-top: 1px solid var(--line); padding-top: 14px; }
  .principles .mono { color: var(--cv-orange); font-size: 0.8rem; margin-right: 8px; }
  .principles strong { font: 600 1.05rem var(--font-display); }
  .principles p { margin: 6px 0 0; color: var(--ink-2); font-size: 0.92rem; }

  .terminal {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 0.95rem var(--font-mono);
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-2);
    width: fit-content;
    max-width: 100%;
    position: relative;
  }
  .prompt { color: var(--qa); }
  .cmd { color: var(--at); }
  .rotator { display: grid; overflow: hidden; height: 1.6em; flex: 1 1 auto; min-width: 0; }
  .rotator span {
    grid-area: 1 / 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    animation: rotate-words 15s infinite;
  }
  .rotator span:nth-child(2) { animation-delay: 3s; }
  .rotator span:nth-child(3) { animation-delay: 6s; }
  .rotator span:nth-child(4) { animation-delay: 9s; }
  .rotator span:nth-child(5) { animation-delay: 12s; }
  @keyframes rotate-words {
    0% { opacity: 0; transform: translateY(100%); }
    3.2%, 16.8% { opacity: 1; transform: none; }
    20%, 100% { opacity: 0; transform: translateY(-100%); }
