---
// Butterfly 360 · Support : reproduction du back-office réel (butterfly/support/front).
// Un email arrive, l'IA le qualifie et l'assigne ; sur la fiche, l'Assistant LMS France
// retrouve le stagiaire, vérifie la règle métier et prépare l'action puis la réponse,
// que l'agent valide à chaque fois.

const win = (a: number, b: number) => ({ class: 'win', style: `--a:${a}s; --b:${b}s` });
const from = (a: number) => ({ class: 'from', style: `--a:${a}s` });
const until = (b: number) => ({ class: 'until', style: `--b:${b}s` });

const D = {
  navy: '#14294B', navy2: '#1F3F75', ink: '#0F1B2D', muted: '#556274', line: '#DCE2EB',
  lineSoft: '#E9EDF3', field: '#CDD5E1', canvas: '#F2F5F9', panel: '#F7F9FC', selected: '#EBF0F7',
};
const nav = ['Dashboard', 'Tickets', 'Indicateurs', 'Formations', 'Paramètres'];
const others = [
  { who: 'Paul Girard', mail: 'compta@aerolis.fr', subject: 'Facture de septembre', lms: 'LMS France', theme: 'Facturation', tfg: '#065F46', tbg: '#E3F5EC', agent: 'Chiarra', st: 'En cours', sfg: '#1F3F75', sbg: '#DCE6F5' },
  { who: 'John Carter', mail: 'j.carter@skyops.co.uk', subject: 'New trainees to enrol', lms: 'LMS UK', theme: 'Inscriptions', tfg: '#1E3A8A', tbg: '#E6ECFB', agent: 'Tom', st: 'À traiter', sfg: '#92400E', sbg: '#FDF0DC' },
  { who: 'Sofia Reyes', mail: 'sreyes@flyedu.com', subject: 'Certificate not received', lms: 'LMS US', theme: 'Gestion des formations', tfg: '#9A3412', tbg: '#FFEDE3', agent: 'Annella', st: 'En cours', sfg: '#1F3F75', sbg: '#DCE6F5' },
];
const reply = [
  'Bonjour Marine,',
  'Le test final de Lucas Martin a été',
  'réinitialisé : il peut le repasser dès',
  'maintenant (2e tentative).',
  'Bonne journée,',
];
---

<div class="scene bf" id="scene-butterfly" data-loop="11500" role="img"
  aria-label="Animation du support Butterfly 360 : un email arrive, l'IA le qualifie, l'assigne à Annella ; sur la fiche, l'Assistant LMS France retrouve le stagiaire, vérifie qu'une deuxième tentative est possible, l'agent valide la réinitialisation du test, reprend la réponse préparée et l'envoie au client.">
  <svg viewBox="0 0 600 400" aria-hidden="true">
    <defs>
      <clipPath id="bf-frame"><rect width="600" height="400" rx="18" /></clipPath>
      {reply.map((_, i) => (
        <clipPath id={`bf-line-${i}`}><rect class="type" style={`--a:${7.5 + i * 0.18}s`} x="126" y={226 + i * 13} width="190" height="12" /></clipPath>
      ))}
      <g id="bf-robot">
        <rect x="-5" y="-2" width="10" height="7.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" />
        <path d="M0,-2 V-4.5" stroke="currentColor" stroke-width="1.2" />
        <circle cy="-5.2" r=".8" fill="currentColor" />
        <circle cx="-2" cy="1.8" r=".8" fill="currentColor" />
        <circle cx="2" cy="1.8" r=".8" fill="currentColor" />
      </g>
    </defs>

    <g clip-path="url(#bf-frame)">
      <rect width="600" height="400" fill={D.canvas} />

      <!-- menu latéral -->
      <rect width="104" height="400" fill={D.navy} />
      <path d="M16,22 c-6,-8 -2,-12 4,-6 c6,-6 10,-2 4,6 c6,8 2,12 -4,6 c-6,6 -10,2 -4,-6 Z" fill="#6E9BE0" opacity=".9" transform="translate(4 2) scale(.8)" />
      <text x="34" y="24" font-size="9.5" font-weight="700" fill="#fff">Butterfly 360</text>
      <text x="34" y="34" font-size="7" fill="#C3CEE0">Support LMS</text>
      {nav.map((n, i) => (
        <g transform={`translate(8 ${54 + i * 22})`}>
          {n === 'Tickets' && <rect width="88" height="18" rx="5" fill={D.navy2} />}
          {n === 'Tickets' && <rect width="2.5" height="18" fill="#6E9BE0" />}
          <text x="12" y="12.2" font-size="8" font-weight={n === 'Tickets' ? 600 : 400} fill={n === 'Tickets' ? '#fff' : '#C3CEE0'}>{n}</text>
        </g>
      ))}

      <!-- ========== boîte de tickets ========== -->
      <g class="until" style="--b:2.85s">
        <text x="118" y="30" font-size="14" font-weight="700" fill={D.ink}>Tickets</text>
        <text x="174" y="30" font-size="8" fill={D.muted}>Boîtes support France · UK · US</text>
        <rect x="118" y="42" width="468" height="210" rx="10" fill="#fff" stroke={D.line} />
        <rect x="119" y="43" width="466" height="16" rx="9" fill={D.panel} />
        <g font-size="6.5" font-weight="600" letter-spacing=".5" fill={D.muted}>
          <text x="130" y="54">CLIENT</text><text x="236" y="54">OBJET</text><text x="378" y="54">LMS · THÉMATIQUE</text><text x="512" y="54">ASSIGNÉ</text>
        </g>

        <!-- tickets existants, qui descendent quand le nouveau arrive -->
        <g class="shift">
          {others.map((t, i) => (
            <g transform={`translate(0 ${96 + i * 36})`}>
              <line x1="119" x2="585" y1="0" y2="0" stroke={D.lineSoft} />
              <text x="130" y="15" font-size="8" font-weight="600" fill={D.ink}>{t.who}</text>
              <text x="130" y="26" font-size="6.8" fill={D.muted}>{t.mail}</text>
              <text x="236" y="20" font-size="8" fill={D.ink}>{t.subject}</text>
              <text x="378" y="14" font-size="6.8" class="m" fill={D.muted}>{t.lms}</text>
              <rect x="378" y="18" width={t.theme.length * 4 + 10} height="11" rx="5.5" fill={t.tbg} />
              <text x="383" y="25.8" font-size="6.5" font-weight="600" fill={t.tfg}>{t.theme}</text>
              <text x="512" y="15" font-size="7.5" fill={D.ink}>{t.agent}</text>
              <rect x="512" y="19" width="40" height="11" rx="5.5" fill={t.sbg} />
              <text x="532" y="26.6" text-anchor="middle" font-size="6.5" font-weight="600" fill={t.sfg}>{t.st}</text>
            </g>
          ))}
        </g>

        <!-- le nouvel email -->
        <g class="newrow">
          <rect x="119" y="60" width="466" height="36" fill="#FFFBEB" />
          <rect class="from" style="--a:2.5s" x="119" y="60" width="466" height="36" fill={D.selected} />
          <text x="130" y="75" font-size="8" font-weight="600" fill={D.ink}>Marine Dupont</text>
          <text x="130" y="86" font-size="6.8" fill={D.muted}>marine@airformation.fr</text>
          <text x="236" y="80" font-size="8" font-weight="600" fill={D.ink}>Test final bloqué pour un stagiaire</text>
          <g {...win(0.9, 2.0)}>
            <rect x="378" y="70" width="64" height="13" rx="6.5" fill={D.lineSoft} />
            <rect class="shimmer" x="378" y="70" width="22" height="13" rx="6.5" fill="#fff" opacity=".8" />
            <text x="386" y="79" font-size="6.8" fill={D.muted}>Qualification…</text>
          </g>
          <g {...from(2.0)}>
            <text x="378" y="74" font-size="6.8" class="m" fill={D.muted}>LMS France</text>
            <rect x="378" y="78" width="102" height="11" rx="5.5" fill="#FFEDE3" />
            <text x="383" y="85.8" font-size="6.5" font-weight="600" fill="#9A3412">Gestion des formations</text>
            <text x="512" y="75" font-size="7.5" font-weight="600" fill={D.ink}>Annella</text>
            <rect x="512" y="79" width="40" height="11" rx="5.5" fill="#FDF0DC" />
            <text x="532" y="86.6" text-anchor="middle" font-size="6.5" font-weight="600" fill="#92400E">À traiter</text>
          </g>
        </g>
        <g class="from" style="--a:2.05s">
          <rect x="118" y="262" width="250" height="22" rx="8" fill="#fff" stroke={D.line} />
          <path d="M131,267 l1.4,3.6 3.4,1.5 -3.4,1.5 -1.4,3.6 -1.4,-3.6 -3.4,-1.5 3.4,-1.5 z" fill="#6E9BE0" />
          <text x="142" y="276.5" font-size="7.5" fill={D.ink}>Qualifié automatiquement · règle « Annella : formations »</text>
        </g>
        <!-- l'enveloppe qui arrive -->
        <g class="mail">
          <rect x="-12" y="-8" width="24" height="16" rx="2.5" fill="#fff" stroke={D.navy2} stroke-width="1.4" />
          <path d="M-12,-7 L0,2 L12,-7" fill="none" stroke={D.navy2} stroke-width="1.4" />
        </g>
      </g>

      <!-- ========== fiche du ticket ========== -->
      <g class="from" style="--a:2.9s">
        <!-- bandeau d'état -->
        <rect x="118" y="12" width="468" height="44" rx="10" fill="#fff" stroke={D.line} />
        <text x="130" y="27" font-size="7" class="m" fill={D.muted}>LMS France · n° 1284</text>
        <text x="130" y="44" font-size="11" font-weight="700" fill={D.ink}>Test final bloqué pour un stagiaire</text>
        <rect x="372" y="24" width="102" height="13" rx="6.5" fill="#FFEDE3" />
        <text x="378" y="33.2" font-size="6.8" font-weight="600" fill="#9A3412">Gestion des formations</text>
        <text x="482" y="33.5" font-size="7.5" font-weight="600" fill={D.ink}>Annella</text>
        <g {...until(8.9)}>
          <rect x="522" y="24" width="52" height="13" rx="6.5" fill="#FDF0DC" />
          <text x="548" y="33.2" text-anchor="middle" font-size="6.8" font-weight="600" fill="#92400E">À traiter</text>
        </g>
        <g {...from(8.9)}>
          <rect x="522" y="24" width="52" height="13" rx="6.5" fill="#DCE6F5" />
          <text x="548" y="33.2" text-anchor="middle" font-size="6.8" font-weight="600" fill={D.navy2}>En cours</text>
        </g>

        <!-- échanges avec le client -->
        <text x="118" y="74" font-size="8.5" font-weight="700" fill={D.ink}>Échanges avec le client</text>
        <rect x="118" y="80" width="204" height="118" rx="10" fill="#fff" stroke={D.line} />
        <circle cx="132" cy="94" r="7" fill={D.lineSoft} />
        <text x="132" y="96.5" text-anchor="middle" font-size="6" font-weight="700" fill={D.navy2}>MD</text>
        <text x="144" y="93" font-size="7.5" font-weight="600" fill={D.ink}>Marine Dupont</text>
        <text x="144" y="102" font-size="6.5" fill={D.muted}>marine@airformation.fr</text>
        <text x="128" y="120" font-size="7.6" fill={D.ink}>
          <tspan>Bonjour,</tspan>
          <tspan x="128" dy="11">Notre stagiaire Lucas Martin n'arrive</tspan>
          <tspan x="128" dy="11">plus à accéder à son test final.</tspan>
          <tspan x="128" dy="11">Pouvez-vous débloquer la situation ?</tspan>
          <tspan x="128" dy="15">Marine — Air Formation</tspan>
        </text>

        <!-- réponse au client -->
        <text x="118" y="214" font-size="8.5" font-weight="700" fill={D.ink}>Réponse au client</text>
        <rect x="118" y="220" width="204" height="128" rx="10" fill="#fff" stroke={D.line} />
        <text {...until(7.5)} x="128" y="234" font-size="7.6" fill={D.muted}>Écrire une réponse au client…</text>
        {reply.map((l, i) => (
          <text clip-path={`url(#bf-line-${i})`} x="128" y={235 + i * 13} font-size="7.6" fill={D.ink}>{l}</text>
        ))}
        <g transform="translate(166 369)">
          <g class="press" style="--a:8.6s">
            <rect x="-48" y="-11" width="96" height="22" rx="7" fill={D.navy} />
            <text y="3" text-anchor="middle" font-size="7.8" font-weight="600" fill="#fff">Envoyer la réponse</text>
          </g>
        </g>

        <!-- Assistant LMS France -->
        <rect x="330" y="66" width="256" height="322" rx="10" fill="#fff" stroke={D.line} />
        <path d="M340,66 H576 a10,10 0 0 1 10,10 V100 H330 V76 a10,10 0 0 1 10,-10 Z" fill={D.navy} />
        <use href="#bf-robot" x="345" y="81" style="color:#fff" />
        <text x="356" y="84" font-size="9" font-weight="600" fill="#fff">Assistant LMS France</text>
        <text x="340" y="95" font-size="6.4" fill="#C3CEE0">Interroge le LMS et prépare l'action. Rien n'est exécuté sans votre validation.</text>

        <!-- l'assistant cherche -->
        <circle cx="348" cy="118" r="8" fill={D.navy} />
        <use href="#bf-robot" x="348" y="118" style="color:#fff" />
        <g {...win(3.2, 3.9)}>
          <circle class="dot" cx="364" cy="118" r="1.8" fill={D.navy2} />
          <circle class="dot d2" cx="370" cy="118" r="1.8" fill={D.navy2} />
          <circle class="dot d3" cx="376" cy="118" r="1.8" fill={D.navy2} />
        </g>
        <text {...from(3.9)} x="362" y="116" font-size="7.6" fill={D.ink}><tspan>J'ai trouvé Lucas Martin dans le LMS France.</tspan><tspan x="362" dy="10">Son test final est échoué (1 tentative sur 2).</tspan></text>

        <!-- stagiaire concerné -->
        <g {...from(4.3)}>
          <text x="340" y="146" font-size="7" font-weight="600" fill={D.muted}>Stagiaire concerné</text>
          <rect x="340" y="151" width="236" height="40" rx="8" fill={D.selected} stroke={D.navy2} stroke-width="1.2" />
          <text x="350" y="164" font-size="8" font-weight="600" fill={D.ink}>Lucas Martin</text>
          <g font-size="6.8">
            <text x="350" y="175" fill={D.muted}>Client</text><text x="378" y="175" fill={D.ink}>Air Formation</text>
            <text x="350" y="185" fill={D.muted}>Formation</text><text x="388" y="185" fill={D.ink}>Sûreté aérienne</text>
            <text x="460" y="175" fill={D.muted}>Test</text><text x="478" y="175" fill={D.ink}>Final · échoué</text>
          </g>
        </g>

        <!-- proposition d'action -->
        <g {...from(4.9)}>
          <rect x="340" y="198" width="236" height="56" rx="8" fill={D.panel} stroke={D.line} />
          <text x="350" y="212" font-size="8" font-weight="600" fill={D.ink}>Réinitialiser le test final</text>
          <rect x="462" y="204" width="84" height="12" rx="6" fill="#E3F3E8" />
          <text x="504" y="212.4" text-anchor="middle" font-size="6.5" font-weight="600" fill="#166534">2e tentative disponible</text>
          <text x="350" y="224" font-size="6.8" fill={D.muted}>Pour Lucas Martin</text>
          <g {...until(5.85)}>
            <g transform="translate(398 241)">
              <g class="press" style="--a:5.6s">
                <rect x="-48" y="-9" width="96" height="18" rx="6" fill={D.navy} />
                <text y="2.8" text-anchor="middle" font-size="7.2" font-weight="600" fill="#fff">Réinitialiser le test final</text>
              </g>
            </g>
            <text x="456" y="244" font-size="7.2" font-weight="600" fill="#9F1239">Refuser</text>
          </g>
          <g {...from(5.9)}>
            <circle cx="355" cy="241" r="5" fill="#E3F3E8" />
            <path d="M352.6,241 L354.4,242.8 L357.6,239.4" fill="none" stroke="#166534" stroke-width="1.3" stroke-linecap="round" />
            <text x="364" y="244" font-size="7.4" font-weight="600" fill="#14532D">Action exécutée dans le LMS.</text>
          </g>
        </g>

        <!-- réponse préparée -->
        <g {...from(6.5)}>
          <rect x="340" y="262" width="236" height="44" rx="8" fill={D.panel} stroke={D.line} />
          <text x="350" y="276" font-size="8" font-weight="600" fill={D.ink}>Réponse préparée</text>
          <text x="424" y="276" font-size="7" font-weight="600" fill={D.navy2}>Relire la réponse</text>
          <rect x="350" y="284" width="48" height="15" rx="5" fill="#fff" stroke={D.field} />
          <text x="374" y="294" text-anchor="middle" font-size="6.8" fill={D.ink}>Régénérer</text>
          <g transform="translate(470 291.5)">
            <g class="press" style="--a:7.2s">
              <rect x="-66" y="-7.5" width="132" height="15" rx="5" fill={D.navy} />
              <text y="2.6" text-anchor="middle" font-size="6.8" font-weight="600" fill="#fff">Reprendre dans la réponse</text>
            </g>
          </g>
        </g>

        <!-- question libre -->
        <line x1="340" x2="576" y1="318" y2="318" stroke={D.lineSoft} />
        <rect x="340" y="328" width="236" height="22" rx="6" fill="#fff" stroke={D.field} />
        <text x="347" y="342" font-size="6.6" fill={D.muted}>Question au LMS, ex. « Rechercher un stagiaire par nom : Dubois »</text>

        <!-- confirmation d'envoi -->
        <g {...from(8.9)}>
          <rect x="118" y="352" width="204" height="0" />
          <rect x="330" y="360" width="256" height="24" rx="8" fill="#E3F3E8" />
          <circle cx="344" cy="372" r="4.5" fill="#166534" />
          <path d="M342,372 L343.6,373.6 L346.4,370.6" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" />
          <text x="354" y="375" font-size="7.6" font-weight="600" fill="#14532D">Réponse envoyée au client par email.</text>
        </g>
      </g>

      <!-- curseur -->
      <g class="cursor">
        <path d="M0,0 L0,15 L4,11.5 L7,18 L9.6,16.8 L6.7,10.5 L11.5,10.2 Z" fill={D.ink} stroke="#fff" stroke-width="1.1" />
      </g>
    </g>
  </svg>
</div>

<style is:global>
  @keyframes bf-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes bf-fadeout { from { opacity: 1; } to { opacity: 0; } }
  @keyframes bf-win { 0% { opacity: 0; } 6%, 94% { opacity: 1; } 100% { opacity: 0; } }

  .bf .from { animation: bf-fade 0.3s var(--a) ease both; }
  .bf .until { animation: bf-fadeout 0.25s var(--b) ease both; }
  .bf .win { opacity: 0; animation: bf-win calc(var(--b) - var(--a)) var(--a) linear; }

  .bf .mail { opacity: 0; animation: bf-mail 0.8s 0.1s cubic-bezier(.5,0,.3,1) both; }
  @keyframes bf-mail {
    0% { opacity: 0; transform: translate(600px, -20px) rotate(-12deg); }
    20% { opacity: 1; }
    80% { opacity: 1; transform: translate(160px, 78px) rotate(0); }
    100% { opacity: 0; transform: translate(150px, 78px) scale(.4); }
  }
  .bf .shift { animation: bf-shift 0.4s 0.75s ease both; }
  @keyframes bf-shift { from { transform: translateY(-36px); } to { transform: none; } }
  .bf .newrow { animation: bf-rowin 0.4s 0.8s ease both; }
  @keyframes bf-rowin { from { opacity: 0; } to { opacity: 1; } }
  .bf .shimmer { animation: bf-shimmer 0.9s ease-in-out infinite; }
  @keyframes bf-shimmer { from { transform: translateX(0); } to { transform: translateX(42px); } }

  .bf .dot { animation: bf-blink 1s ease-in-out infinite; }
  .bf .d2 { animation-delay: .15s; }
  .bf .d3 { animation-delay: .3s; }
  @keyframes bf-blink { 50% { opacity: .25; } }

  .bf .type { transform-box: fill-box; transform-origin: left; animation: bf-type 0.35s var(--a) steps(14) both; }
  @keyframes bf-type { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .bf .press { transform-box: fill-box; transform-origin: center; animation: bf-press 0.3s var(--a) ease both; }
  @keyframes bf-press { 50% { transform: scale(.9); } }

  .bf .cursor { opacity: 0; animation: bf-cursor 7s 2.2s ease-in-out both; }
  @keyframes bf-cursor {
    0% { opacity: 0; transform: translate(450px, 300px); }
    2% { opacity: 1; transform: translate(450px, 300px); }
    5.7% { transform: translate(300px, 80px); }
    37.1% { transform: translate(300px, 80px); }
    47.1% { transform: translate(398px, 241px); }
    51.4% { transform: translate(398px, 241px); }
    70% { transform: translate(470px, 292px); }
    74.3% { transform: translate(470px, 292px); }
    90% { opacity: 1; transform: translate(166px, 369px); }
    94.3% { opacity: 1; transform: translate(166px, 369px); }
    100% { opacity: 0; transform: translate(180px, 390px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bf .cursor, .bf .mail { opacity: 0 !important; }
  }
</style>
